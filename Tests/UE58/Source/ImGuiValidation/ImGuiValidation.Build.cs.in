using UnrealBuildTool;
public class ImGuiValidation : ModuleRules
{
    public ImGuiValidation(ReadOnlyTargetRules Target) : base(Target)
    {
        PCHUsage = PCHUsageMode.UseExplicitOrSharedPCHs;
        PrivateDependencyModuleNames.AddRange(new[] { "Core", "CoreUObject", "Engine", "ImGui" });
    }
}
